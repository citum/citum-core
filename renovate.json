{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["cargo", "github-actions"],
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 5,
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am"]
  },
  "semanticCommits": "enabled",
  "semanticCommitScope": "tooling",
  "commitMessageAction": "update",
  "commitBody": "Update dependencies and lock files managed by Renovate.",
  "commitBodyTable": false,
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "schedule": ["at any time"],
    "groupName": null
  },
  "packageRules": [
    {
      "matchManagers": ["cargo"],
      "groupName": "cargo deps",
      "groupSlug": "cargo-deps",
      "semanticCommitType": "chore",
      "commitMessageTopic": "cargo deps",
      "commitMessageExtra": ""
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "actions",
      "groupSlug": "actions",
      "semanticCommitType": "chore",
      "semanticCommitScope": "ci",
      "commitMessageTopic": "actions",
      "commitMessageExtra": ""
    }
  ]
}
